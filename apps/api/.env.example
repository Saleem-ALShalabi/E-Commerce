# Copy this file to .env  ->  cp .env.example .env
PORT=3001
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5433/ecommerce?schema=public"

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# URL of the Next.js app (allowed by CORS)
WEB_ORIGIN="http://localhost:3000"
